{
  "name": "@lyonbrown/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "generate:check": "tsx scripts/check-generated.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts scripts/**/*.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm generate:check && vitest run",
    "build": "pnpm generate:check && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "grpc-tools": "1.13.1",
    "protobufjs": "8.8.0",
    "ts-proto": "2.12.4"
  }
}
