{
  "name": "@lyonbrown/agent-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dependencies:build": "pnpm --filter \"@lyonbrown/agent-cli^...\" --workspace-concurrency=1 run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "prelint": "pnpm dependencies:build",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs src tests vitest.config.ts eslint.config.mjs",
    "pretypecheck": "pnpm dependencies:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm dependencies:build",
    "test": "vitest run --coverage",
    "prebuild": "pnpm dependencies:build",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.0.0",
    "@lyonbrown/agent-client": "workspace:*",
    "@lyonbrown/agent-launch": "workspace:*",
    "@lyonbrown/ui-model": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  }
}
