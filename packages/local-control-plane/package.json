{
  "name": "@lyonbrown/local-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native-adapter": {
      "types": "./dist/native-adapter.d.ts",
      "import": "./dist/native-adapter.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs,md}\"",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs src tests scripts vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "clean": "tsx scripts/clean.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11"
  }
}
