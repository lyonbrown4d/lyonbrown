# Fully-qualified local directory reserved for verified System One decision-model installations.
LYONBROWN_DECISION_MODEL_ROOT=<absolute-local-path>

# Fully-qualified persistent directory for verified local chat-model installations.
LYONBROWN_LOCAL_MODEL_ROOT=<absolute-local-path>

# Fully-qualified scratch root for real local daemon/gRPC/TUI black-box runs.
LYONBROWN_BLACKBOX_ROOT=<absolute-local-path>

# Electron client configuration; optional. Workspace defaults to this repository.
# LYONBROWN_DESKTOP_WORKSPACE=<absolute-workspace-path>
# LYONBROWN_DESKTOP_HOME=<absolute-home-path>
# Use standalone Node 24, never the Electron executable, to start agentd.
LYONBROWN_DESKTOP_NODE_EXECUTABLE=node
LYONBROWN_DESKTOP_AUTOSTART=true
