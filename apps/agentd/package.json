{
  "name": "@lyonbrown/agentd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "dependencies:build": "pnpm --filter \"@lyonbrown/agentd^...\" --workspace-concurrency=1 run build",
    "format": "prettier --write \"node-src/**/*.ts\" \"node-tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"node-src/**/*.ts\" \"node-tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "prelint": "pnpm dependencies:build",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs node-src node-tests vitest.config.ts eslint.config.mjs",
    "pretypecheck": "pnpm dependencies:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm dependencies:build",
    "test": "vitest run --coverage",
    "prebuild": "pnpm dependencies:build",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@lyonbrown/agent-runtime": "workspace:*",
    "@lyonbrown/control-plane-native": "workspace:*",
    "@lyonbrown/local-control-plane": "workspace:*",
    "@lyonbrown/protocol": "workspace:*"
  },
  "devDependencies": {
    "@lyonbrown/agent-domain": "workspace:*",
    "@lyonbrown/event-store": "workspace:*",
    "@lyonbrown/kernel-pi": "workspace:*",
    "@vitest/coverage-v8": "4.1.11"
  }
}
