# agentd owns provider credentials. Clients use auth.token from the user data directory.
LYONBROWN_LISTEN=127.0.0.1:7447
LYONBROWN_ENDPOINT=http://127.0.0.1:7447
LYONBROWN_PROVIDER=openai
LYONBROWN_MODEL=gpt-4.1
LYONBROWN_SUPPORTS_IMAGES=false
# Optional advisory classifier. Omit its model to use the workspace rule.
# LYONBROWN_DECISION_MODEL=
# LYONBROWN_DECISION_PROVIDER=openai
# LYONBROWN_DECISION_API_BASE=https://api.openai.com/v1
LYONBROWN_DECISION_TIMEOUT_MS=3000
LYONBROWN_DECISION_MINIMUM_CONFIDENCE=0.75
# LYONBROWN_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LYONBROWN_DATA_DIR=
LYONBROWN_MAX_RUNS=4
LYONBROWN_RUN_TIMEOUT_SECS=900
RUST_LOG=agentd=info
