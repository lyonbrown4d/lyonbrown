{
  "name": "@lyonbrown/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dependencies:build": "pnpm --filter \"@lyonbrown/agent-runtime^...\" --workspace-concurrency=1 run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,ts,mjs}\"",
    "prelint": "pnpm dependencies:build",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs src tests eslint.config.mjs",
    "pretypecheck": "pnpm dependencies:build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm dependencies:build",
    "test": "vitest run --coverage",
    "prebuild": "pnpm dependencies:build",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "dependencies": {
    "@lyonbrown/agent-domain": "workspace:*",
    "@lyonbrown/event-store": "workspace:*",
    "@lyonbrown/kernel-pi": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11"
  }
}
