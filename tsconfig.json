{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@lyonbrown/workspace/internal/*": ["scripts/*.ts"],
      "@lyonbrown/agent-cli/internal/*": ["apps/agent-cli/src/*.ts"],
      "@lyonbrown/agent-cli/test/*": ["apps/agent-cli/tests/*.ts"],
      "@lyonbrown/agentd/internal/*": ["apps/agentd/node-src/*.ts"],
      "@lyonbrown/agentd/test/*": ["apps/agentd/node-tests/*.ts"],
      "@lyonbrown/agent-client/internal/*": ["packages/agent-client/src/*.ts"],
      "@lyonbrown/agent-client/test/*": ["packages/agent-client/tests/*.ts"],
      "@lyonbrown/agent-domain/internal/*": ["packages/agent-domain/src/*.ts"],
      "@lyonbrown/agent-domain/test/*": ["packages/agent-domain/tests/*.ts"],
      "@lyonbrown/agent-launch/internal/*": ["packages/agent-launch/src/*.ts"],
      "@lyonbrown/agent-launch/test/*": ["packages/agent-launch/tests/*.ts"],
      "@lyonbrown/agent-runtime/internal/*": ["packages/agent-runtime/src/*.ts"],
      "@lyonbrown/agent-runtime/test/*": ["packages/agent-runtime/tests/*.ts"],
      "@lyonbrown/control-plane-native/internal/*": ["packages/control-plane-native/src/*.ts"],
      "@lyonbrown/control-plane-native/test/*": ["packages/control-plane-native/tests/*.ts"],
      "@lyonbrown/control-plane-native/config/vitest": [
        "packages/control-plane-native/vitest.config.ts"
      ],
      "@lyonbrown/event-store/internal/*": ["packages/event-store/src/*.ts"],
      "@lyonbrown/event-store/test/*": ["packages/event-store/tests/*.ts"],
      "@lyonbrown/kernel-pi/internal/*": ["packages/kernel-pi/src/*.ts"],
      "@lyonbrown/kernel-pi/test/*": ["packages/kernel-pi/tests/*.ts"],
      "@lyonbrown/local-control-plane/internal/*": ["packages/local-control-plane/src/*.ts"],
      "@lyonbrown/local-control-plane/test/*": ["packages/local-control-plane/tests/*.ts"],
      "@lyonbrown/local-model/internal/*": ["packages/local-model/src/*.ts"],
      "@lyonbrown/local-model/test/*": ["packages/local-model/tests/*.ts"],
      "@lyonbrown/local-model/script/*": ["packages/local-model/scripts/*.ts"],
      "@lyonbrown/protocol/internal/*": ["packages/protocol/src/*.ts"],
      "@lyonbrown/protocol/generated/*": ["packages/protocol/src/generated/*.ts"],
      "@lyonbrown/protocol/test/*": ["packages/protocol/tests/*.ts"],
      "@lyonbrown/protocol/script/*": ["packages/protocol/scripts/*.ts"],
      "@lyonbrown/ui-model/internal/*": ["packages/ui-model/src/*.ts"],
      "@lyonbrown/ui-model/test/*": ["packages/ui-model/tests/*.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
