{
  "name": "@lyonbrown/kernel-pi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \"README.md\"",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs src tests scripts eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage && tsx scripts/check-coverage.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.20.6"
  }
}
