{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "scripts",
    "outDir": "dist/scripts",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/tests/**/*.ts", "dist", "node_modules"]
}
