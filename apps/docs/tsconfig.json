{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "astro/client"]
  },
  "include": [".astro/types.d.ts", "astro.config.ts", "src/**/*", "tests/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
