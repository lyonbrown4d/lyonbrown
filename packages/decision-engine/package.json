{
  "name": "@lyonbrown/decision-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composition": {
      "types": "./dist/composition-entry.d.ts",
      "import": "./dist/composition-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.{json,ts,mjs}\" \"README.md\"",
    "lint": "pnpm format:check && eslint --config eslint.config.mjs src tests scripts vitest.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js && tsx scripts/smoke-built-worker.ts"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "open-jev": "0.1.2",
    "piscina": "5.3.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "18.0.5"
  }
}
