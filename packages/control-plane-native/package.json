{
  "name": "@lyonbrown/control-plane-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "dependencies:build": "pnpm --filter \"@lyonbrown/control-plane-native^...\" --workspace-concurrency=1 run build",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js"
  },
  "dependencies": {
    "@lyonbrown/event-store": "workspace:*",
    "@lyonbrown/local-control-plane": "workspace:*",
    "@lyonbrown/local-model": "workspace:*",
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@vitest/coverage-v8": "4.1.11",
    "better-sqlite3": "13.0.3",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
